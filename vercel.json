{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node erp/build-preview.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/demo/login", "permanent": false }
  ],
  "rewrites": [
    { "source": "/demo/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/staff.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Content-Security-Policy", "value": "connect-src 'self'; object-src 'none'; base-uri 'none'" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
