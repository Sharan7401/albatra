{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://albatra.base44.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://albatra.base44.app/socket.io/:path*"
    },
    {
      "source": "/assets/index-B4sSgSHQ.js",
      "destination": "/index-B4sSgSHQ.js"
    },
    {
      "source": "/assets/index-yny9lcrr.css",
      "destination": "/index-yny9lcrr.css"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://albatra.base44.app/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://albatra.base44.app/favicon.svg"
    },
    {
      "source": "/manifest.json",
      "destination": "https://albatra.base44.app/manifest.json"
    },
    {
      "source": "/demo-workspace.js",
      "destination": "/demo-runtime/workspace.js"
    },
    {
      "source": "/erp/:path*",
      "destination": "/demo-runtime/modules/:path*"
    },
    {
      "source": "/demo",
      "destination": "/demo-runtime/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/demo-runtime/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'none'; object-src 'none'; base-uri 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "buildCommand": "node erp/build-main.mjs",
  "outputDirectory": "dist"
}
